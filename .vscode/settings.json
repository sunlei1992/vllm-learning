{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.exclude": {
    "**/.uv-cache": true,
    "**/.hf-cache": true,
    "**/.vllm-cache": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.uv-cache": true,
    "**/.hf-cache": true,
    "**/.vllm-cache": true
  },
  "files.watcherExclude": {
    "**/.uv-cache": true,
    "**/.hf-cache": true,
    "**/.vllm-cache": true
  }
}
